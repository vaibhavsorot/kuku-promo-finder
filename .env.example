# Local provider settings. Choose one provider and add its key to .env.

# --- Option A: Google Gemini free tier (https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Free tier is rate-limited; space out calls and run fewer in parallel:
LLM_MAX_WORKERS=1
LLM_MIN_INTERVAL_S=7

# --- Option B: any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama, an internal gateway)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1      # Ollama: http://localhost:11434/v1 (no key needed)
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=
# LLM_JSON_MODE=1                                  # set 0 if the endpoint rejects response_format

# --- Option C: Anthropic Claude API (pip install anthropic)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

# --- Option D: local Claude Code CLI (`claude -p`), no API key; used for the submitted run
# LLM_PROVIDER=claude_cli
# LLM_MODEL=claude-sonnet-5-5

# --- Option E: replay a previous run from cache only (offline demo; fails on any cache miss)
# LLM_PROVIDER=replay

# --- General
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
# LLM_MAX_WORKERS=4
# PROMO_INPUT_DIR=data/input
